# Copy to Inventory_management/.env for docker compose
# (Compose also reads backend/.env if present.)

# Public URL users open in the browser
FRONTEND_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=3001

# Vite build-time API base (keep /api when using nginx proxy)
VITE_API_URL=/api

# --- Required (or put these in backend/.env) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/batterymela?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Optional integrations
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
