# Copy to .env in this folder and restart: npm run dev

PORT=3001
# Base URL embedded in quotation PDF links (quotationPublicUrl) and sent to Meta WhatsApp.
# Use PUBLIC HTTPS that points at THIS API (port 3001), e.g. ngrok. NOT localhost for phones/WhatsApp.
# If you see "This site can't be reached" on Open PDF: wrong URL, server stopped, or localhost from another device.
#PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
VITE_API_URL=/api

# --- Required for MongoDB + auth ---
MONGODB_URI=mongodb://shravani:Sanjay%40921@ac-pbofmo6-shard-00-00.9dui6ya.mongodb.net:27017,ac-pbofmo6-shard-00-01.9dui6ya.mongodb.net:27017,ac-pbofmo6-shard-00-02.9dui6ya.mongodb.net:27017/?ssl=true&replicaSet=atlas-13avyh-shard-0&authSource=admin&appName=Batterymela
JWT_SECRET=jwtmysecretkeyforinventorymanagementsystem
# First user when database is empty (plain text; only used on first boot)
BOOTSTRAP_ADMIN_EMAIL=shravanijadhav921@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=password@123
# BOOTSTRAP_ADMIN_NAME=Super Admin
# JWT lifetime (optional)
# JWT_EXPIRES_IN=7d

# --- Meta WhatsApp Cloud API (optional; developers.facebook.com) ---
# Graph version (default v22.0). Use same major as in Meta app dashboard if you see 400 errors.
# META_GRAPH_API_VERSION=v22.0
META_ACCESS_
META_PHONE_NUMBER_ID=1177291385463716
META_VERIFY_TOKEN=verifytokenforinventorymanagementsystem

# --- Cloudinary (optional; strongly recommended for WhatsApp quotation PDFs) ---
# When CLOUDINARY_* is set, quotation PDFs are uploaded to Cloudinary and Meta receives that HTTPS URL
# (works even if PUBLIC_BASE_URL is still localhost). Invoices already use Cloudinary for PDFs.
CLOUDINARY_CLOUD_NAME=Inventory Management System
CLOUDINARY_API_KEY=446171992779972
CLOUDINARY_API_SECRET=UPbM74h3C1evdLFmlGBZJONCaFk

