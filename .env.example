# Copy to .env in this folder and restart: npm run dev
# Never commit real secrets in this file.

PORT=3001
# Base URL embedded in quotation PDF links (quotationPublicUrl) and sent to Meta WhatsApp.
# Use PUBLIC HTTPS that points at THIS API (port 3001), e.g. ngrok. NOT localhost for phones/WhatsApp.
# If you see "This site can't be reached" on Open PDF: wrong URL, server stopped, or localhost from another device.
PUBLIC_BASE_URL=https://your-domain.com
VITE_API_URL=/api

# --- Required for MongoDB + auth ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/batterymela?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
# First user when database is empty (plain text; only used on first boot)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# BOOTSTRAP_ADMIN_NAME=Super Admin
# JWT lifetime (optional)
# JWT_EXPIRES_IN=7d

# --- Meta WhatsApp Cloud API (optional; developers.facebook.com) ---
# Graph version (default v22.0). Use same major as in Meta app dashboard if you see 400 errors.
# META_GRAPH_API_VERSION=v22.0
META_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_VERIFY_TOKEN=your-meta-webhook-verify-token

# --- BatteryMela PDF letterhead (optional HTTPS logo for combo quotations + invoices) ---
# Default local logo: public/assets/logos/batterymela-logo.png
# BATTERYMELA_LOGO_URL=https://res.cloudinary.com/your-cloud/image/upload/v1/batterymela/logo.png
# BATTERYMELA_GSTIN=27XXXXXXXXXXZ1
# BATTERYMELA_PHONE=+91 98765 43210
# BATTERYMELA_EMAIL=support@batterymela.com
# BATTERYMELA_ADDRESS=BatteryMela — Power Backup Solutions

# --- Cloudinary (optional; strongly recommended for WhatsApp quotation PDFs) ---
# When CLOUDINARY_* is set, quotation PDFs are uploaded to Cloudinary and Meta receives that HTTPS URL
# (works even if PUBLIC_BASE_URL is still localhost). Invoices already use Cloudinary for PDFs.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Quotation PDF cleanup (default: every 60 min, delete files older than 24h)
# QUOTATION_CLEANUP_INTERVAL_MS=3600000
