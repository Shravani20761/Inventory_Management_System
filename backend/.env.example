# Copy to .env in this folder
PORT=3001
NODE_ENV=development

# Public HTTPS URL of THIS API (PDFs / WhatsApp). On Hostinger use your backend domain.
PUBLIC_BASE_URL=https://api.your-domain.com

# Frontend origin for CORS (exact browser origin, no trailing slash). Comma-separated for multiple.
# Production example (Cloudflare Pages):
# FRONTEND_ORIGIN=https://quickfixsinventorymanagement.pages.dev
FRONTEND_ORIGIN=http://localhost:5173

# --- Required for MongoDB + auth ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/batterymela?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# BOOTSTRAP_ADMIN_NAME=Super Admin
# JWT_EXPIRES_IN=7d

# --- Meta WhatsApp Cloud API (optional) ---
# META_GRAPH_API_VERSION=v22.0
META_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_VERIFY_TOKEN=your-meta-webhook-verify-token

# --- Cloudinary (optional) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional: system Chrome/Chromium path for PDF generation (Puppeteer)
# PUPPETEER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# --- Hostinger notes ---
# Do NOT set PORT in hPanel Environment Variables — Hostinger injects PORT automatically.
# Set PUBLIC_BASE_URL to your Node app HTTPS domain.
# Set FRONTEND_ORIGIN to your static frontend HTTPS origin.
