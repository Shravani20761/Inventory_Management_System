# Hostinger Node.js (backend) environment template
# Do NOT set PORT — Hostinger injects it. Setting PORT=3001 breaks the proxy.

NODE_ENV=production
PUBLIC_BASE_URL=https://api.krishnainfotec.com
FRONTEND_ORIGIN=https://quickfixsinventorymanagement.pages.dev

# Include /databaseName. Omitting it makes MongoDB use "test".
# Use the SAME URI (same cluster + same database) as local backend/.env.
# Check GET https://api.krishnainfotec.com/api/health → mongoDbName
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/batterymela?retryWrites=true&w=majority
# MONGODB_DB_NAME=batterymela
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=Super Admin

META_GRAPH_API_VERSION=v22.0
META_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_VERIFY_TOKEN=your-meta-webhook-verify-token

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
