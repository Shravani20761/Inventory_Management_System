{
  "name": "inventory-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Battery Inventory Management API (Express + MongoDB)",
  "main": "index.js",
  "scripts": {
    "start": "node --use-system-ca index.js",
    "dev": "node --use-system-ca --watch index.js",
    "build": "node -e \"console.log('Backend: no compile step — use npm start')\"",
    "seed": "node --use-system-ca scripts/seed.js",
    "seed:vehicle-batteries": "node --use-system-ca scripts/seedVehicleBatteryDemo.js",
    "seed:combo-catalog": "node --use-system-ca scripts/seedDedicatedComboCatalog.js",
    "seed:dynamic-inv-bat": "node --use-system-ca scripts/seedDynamicInvBatCatalog.js",
    "seed:vehicle-compatibility": "node --use-system-ca scripts/seedVehicleCompatibilityExample.js",
    "seed:branches": "node --use-system-ca scripts/seedBranches.js",
    "seed:branch-users": "node --use-system-ca scripts/seedBranchUsers.js",
    "db:sync-indexes": "node --use-system-ca scripts/syncIndexes.js",
    "seed:demo-may": "node --use-system-ca scripts/seedDemoMayInvoices.js",
    "seed:demo-may:clear": "node --use-system-ca scripts/seedDemoMayInvoices.js clear",
    "clear:quotation-pdfs": "node --use-system-ca scripts/clearGeneratedQuotations.js",
    "clear:quotations-db": "node --use-system-ca scripts/clearQuotationsQueue.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "puppeteer": "^25.0.4",
    "xlsx": "^0.18.5"
  }
}
