# Frontend env (Vite). Values are inlined at BUILD time.
# Local dev: leave VITE_API_URL=/api OR unset — the app calls http://127.0.0.1:3001/api directly (no Vite proxy).
# Optional override: VITE_API_DIRECT=http://127.0.0.1:3001/api
# Hostinger static: set to your backend HTTPS API root INCLUDING /api
# Example: https://api.your-domain.com/api
VITE_API_URL=/api
