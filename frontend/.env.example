# Frontend env (Vite). Values are inlined at BUILD time — changing them on the host after build does nothing.
# Local `npm run dev`: leave as /api (or unset). The app calls http://127.0.0.1:3001/api (your PC only).
# Optional: VITE_API_DIRECT=http://127.0.0.1:3001/api
# Production builds use .env.production (https://api.krishnainfotec.com/api), not this file.
VITE_API_URL=/api
