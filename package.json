{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:clean": "powershell -NoProfile -Command \"foreach ($p in 3001,5173) { Get-NetTCPConnection -LocalPort $p -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } }; exit 0\"",
    "dev": "npm run dev:clean && concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "server": "node --use-system-ca server/index.js",
    "start": "node --use-system-ca server/index.js",
    "hostinger:build": "npm ci && npm run build",
    "hostinger:start": "npm start",
    "dev:all": "npm run dev",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node --use-system-ca server/scripts/seed.js",
    "seed:vehicle-batteries": "node --use-system-ca server/scripts/seedVehicleBatteryDemo.js",
    "seed:combo-catalog": "node --use-system-ca server/scripts/seedDedicatedComboCatalog.js",
    "seed:dynamic-inv-bat": "node --use-system-ca server/scripts/seedDynamicInvBatCatalog.js",
    "seed:vehicle-compatibility": "node --use-system-ca server/scripts/seedVehicleCompatibilityExample.js",
    "seed:branches": "node --use-system-ca server/scripts/seedBranches.js",
    "seed:branch-users": "node --use-system-ca server/scripts/seedBranchUsers.js",
    "db:sync-indexes": "node --use-system-ca server/scripts/syncIndexes.js",
    "seed:demo-may": "node --use-system-ca server/scripts/seedDemoMayInvoices.js",
    "seed:demo-may:clear": "node --use-system-ca server/scripts/seedDemoMayInvoices.js clear",
    "clear:quotation-pdfs": "node --use-system-ca server/scripts/clearGeneratedQuotations.js",
    "clear:quotations-db": "node --use-system-ca server/scripts/clearQuotationsQueue.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "puppeteer": "^25.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "description": "Rule-based battery/inverter quotation engine with React + Tailwind, Express, MongoDB, Puppeteer PDF, **Meta WhatsApp Cloud API**, and **Cloudinary** (invoices only).",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
